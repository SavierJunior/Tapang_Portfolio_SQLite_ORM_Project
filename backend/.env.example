# ============================================================================
#  Tapang Portfolio - backend settings (SQLite)
# ============================================================================
#  1. Copy this file to ".env" in the SAME folder (backend/.env):
#        Copy-Item .env.example .env
#  2. Replace every value that starts with YOUR_ ...
#  3. Never commit the real .env file and never put these values in the frontend.
#
#  XAMPP, MySQL and phpMyAdmin are NOT needed any more.
# ============================================================================

# ---- Database (SQLite file) -------------------------------------------------
# Prisma resolves this path from the backend/prisma folder, so "../portfolio.db"
# means backend/portfolio.db. The file is created automatically by
# "npm run prisma:migrate". Leave this line as it is.
DATABASE_URL="file:../portfolio.db"

# ---- Server -----------------------------------------------------------------
PORT=3000
# The address of the React (Vite) site. Several origins can be separated by commas.
FRONTEND_ORIGIN="http://localhost:5173"

# ---- Login security ---------------------------------------------------------
# A random string of AT LEAST 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="YOUR_LONG_RANDOM_SECRET"

# ---- Administrator account (created by "npm run db:seed") ------------------
# ADMIN_USERNAME: 3-60 characters, letters / numbers / . _ -
# ADMIN_PASSWORD: 10-72 characters. It is saved as a bcrypt hash, never as plain text.
# Changing these values and running "npm run db:seed" again updates the same admin.
ADMIN_NAME="YOUR_FULL_NAME"
ADMIN_USERNAME="YOUR_ADMIN_USERNAME"
ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# ---- Optional settings (the defaults shown are used when a line is missing) --
# MAX_IMAGE_MB=5
# MAX_VIDEO_MB=50
# MAX_RESUME_MB=10
# MAX_PROJECT_IMAGES=10
# MESSAGE_RATE_LIMIT_MAX=5
# MESSAGE_RATE_LIMIT_WINDOW_MIN=15
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MIN=15
# RESUME_DOWNLOAD_NAME="Andrei_Tapang_Resume.pdf"
