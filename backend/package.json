{
  "name": "tapang-portfolio-backend",
  "version": "1.0.0",
  "description": "Express + Prisma 6 + SQLite API for the Tapang portfolio (projects, uploads, messages, admin)",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "prisma:validate": "node ./node_modules/prisma/build/index.js validate",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:dev": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:status": "node ./node_modules/prisma/build/index.js migrate status",
    "prisma:studio": "node ./node_modules/prisma/build/index.js studio",
    "db:seed": "node prisma/seed.js",
    "db:setup": "npm run prisma:validate && npm run prisma:generate && npm run prisma:migrate && npm run db:seed",
    "db:reset": "node ./node_modules/prisma/build/index.js migrate reset --skip-seed && npm run db:seed"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
