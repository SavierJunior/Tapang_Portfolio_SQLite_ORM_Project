# Optional. Copy to "frontend/.env" only if your backend is NOT at http://localhost:3000
#   Copy-Item .env.example .env
# After changing this file, stop Vite (Ctrl + C) and run "npm run dev" again.
# NOTE: VITE_ variables are visible in the browser - never put passwords or secrets here.
VITE_API_BASE_URL=http://localhost:3000
